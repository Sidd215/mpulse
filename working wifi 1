#define REMOTEXY_MODE__ESP32CORE_WIFI_POINT

#include <WiFi.h>
#include <RemoteXY.h>

// WiFi settings
#define REMOTEXY_WIFI_SSID "ESP32_CAR"
#define REMOTEXY_WIFI_PASSWORD "12345678"
#define REMOTEXY_SERVER_PORT 6377

#pragma pack(push, 1)
uint8_t RemoteXY_CONF[] = 
{ 
  255,3,0,0,0,48,0,19,0,0,0,69,83,80,51,50,95,67,65,82,
  0,8,1,106,200,1,1,2,0,5,9,121,48,48,0,2,26,31,2,57,
  35,37,17,0,2,26,31,31,79,78,0,79,70,70,0 
};

struct {
  int8_t joystick_01_x;
  int8_t joystick_01_y;
  uint8_t switch_01;
} RemoteXY;
#pragma pack(pop)

// Motor pins
#define IN1 26
#define IN2 27
#define IN3 14
#define IN4 12
#define ENA 25
#define ENB 33

// Smooth control variables
int currentLeft = 0;
int currentRight = 0;

void setupMotors() {
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  ledcAttachPin(ENA, 0);
  ledcSetup(0, 1000, 8);

  ledcAttachPin(ENB, 1);
  ledcSetup(1, 1000, 8);
}

// Smooth ramp function
int smooth(int current, int target, int step = 5) {
  if (current < target) return min(current + step, target);
  if (current > target) return max(current - step, target);
  return current;
}

void setMotor(int left, int right) {
  // direction LEFT
  if (left >= 0) {
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
  } else {
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    left = -left;
  }

  // direction RIGHT
  if (right >= 0) {
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
  } else {
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);
    right = -right;
  }

  left = constrain(left, 0, 255);
  right = constrain(right, 0, 255);

  ledcWrite(0, left);
  ledcWrite(1, right);
}

void setup() {
  Serial.begin(115200);
  RemoteXY_Init();
  setupMotors();

  Serial.println("System Ready");
}

void loop() {
  RemoteXY_Handler();

  int x = RemoteXY.joystick_01_x;
  int y = RemoteXY.joystick_01_y;

  // dead zone
  if (abs(x) < 5) x = 0;
  if (abs(y) < 5) y = 0;

  // map to speed
  int speedX = map(x, -100, 100, -255, 255);
  int speedY = map(y, -100, 100, -255, 255);

  if (RemoteXY.switch_01 == 0) {
    // 🔵 MANUAL MODE
    int targetLeft  = speedY + speedX;
    int targetRight = speedY - speedX;

    // smooth ramp
    currentLeft  = smooth(currentLeft, targetLeft);
    currentRight = smooth(currentRight, targetRight);

    setMotor(currentLeft, currentRight);

    Serial.println("Manual Mode");
  } 
  else {
    // 🔴 AUTO MODE
    Serial.println("Auto Mode");

    // stop smoothly
    currentLeft  = smooth(currentLeft, 0);
    currentRight = smooth(currentRight, 0);

    setMotor(currentLeft, currentRight);

    // 👉 future: add sensors here
  }

  Serial.print("X: ");
  Serial.print(x);
  Serial.print(" Y: ");
  Serial.println(y);

  delay(20); // small delay for stability
}
