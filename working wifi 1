/*
   RemoteXY setup
*/

#define REMOTEXY_MODE__ESP32CORE_WIFI_POINT

#include <WiFi.h>
#include <RemoteXY.h>

// WiFi settings
#define REMOTEXY_WIFI_SSID "ESP32_CAR"
#define REMOTEXY_WIFI_PASSWORD "12345678"
#define REMOTEXY_SERVER_PORT 6377

// RemoteXY configuration
#pragma pack(push, 1)
uint8_t RemoteXY_CONF[] =   // this will be auto-generated
{ 
  255,0,0,0,0,34,0,13,13,0,
  5,1,6,6,88,88,2,26,31
};

struct {
  int8_t joystick_x; // -100 to 100
  int8_t joystick_y; // -100 to 100
} RemoteXY;
#pragma pack(pop)

void setup() {
  Serial.begin(115200);

  RemoteXY_Init();
}

void loop() {
  RemoteXY_Handler();

  int x = RemoteXY.joystick_x;
  int y = RemoteXY.joystick_y;

  Serial.print("X: ");
  Serial.print(x);
  Serial.print(" | Y: ");
  Serial.println(y);
}
